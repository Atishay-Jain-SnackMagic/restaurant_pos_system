<% if current_order_has_line_items? %>
  <div class="relative">
    <%= link_to cart_path do %>
      <p class="t-0 absolute left-0 flex items-center justify-center w-4 h-4 bg-red-500 text-xs text-white rounded-full">
        <%= current_order.line_items.count %>
      </p>

      <img src="/cart.svg" alt="Cart Icon" class="w-10 bg-white">
    <% end %>
  </div>
<% end %>
