<% content_for :title, 'Order details' %>

<h1 class="text-3xl font-semibold text-center text-gray-800 mb-4">Order details of number: <%= @order.number %></h1>

<%= render partial: 'order', object: @order %>

<div class="mt-6 text-center">
  <%= link_to t('.back_to_orders'), admin_location_pos_path(@order.location_id), class: "inline-block bg-blue-600 text-white w-full py-2 rounded-md font-medium hover:bg-blue-700 transition" %>
</div>
